<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SandwichController"
      stylesheets="@/css/app.css">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="Build Your Sandwich"
           styleClass="section-title"/>

    <VBox spacing="8">
        <Label text="Bread"/>
        <ComboBox fx:id="breadCombo"
                  prefWidth="280"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Protein"/>
        <ComboBox fx:id="proteinCombo"
                  prefWidth="280"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Add-ons"/>
        <ListView fx:id="addOnsList"
                  prefHeight="150"
                  prefWidth="280"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Quantity"/>
        <Spinner fx:id="qtySpinner"
                 prefWidth="140"
                 minWidth="140"
                 editable="true"/>
    </VBox>

    <HBox spacing="10"
          alignment="CENTER_LEFT">

        <Label text="Price:"
               styleClass="price-label"/>

        <Label fx:id="priceLabel"
               styleClass="price"
               text="0.00"/>

    </HBox>

    <Button text="Add to Order"
            onAction="#handleAdd"
            maxWidth="Infinity"
            styleClass="primary-button"/>

</VBox>