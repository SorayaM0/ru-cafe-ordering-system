<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox spacing="20"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.CoffeeController"
      stylesheets="@/css/app.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <VBox spacing="16"
          prefWidth="320"
          styleClass="menu-panel">

        <Label text="Select Coffee"
               styleClass="section-title"/>

        <VBox spacing="8">
            <Label text="Cup Size"/>
            <ComboBox fx:id="sizeCombo"
                      prefWidth="260"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Add-ins"/>
            <MenuButton fx:id="addInsMenu"
                        text="Choose add-ins"
                        prefWidth="260"/>
        </VBox>

        <Label fx:id="selectedAddInsLabel"
               text="No add-ins selected"
               wrapText="true"
               maxWidth="260"
               styleClass="image-caption"/>

        <VBox spacing="8">
            <Label text="Quantity"/>
            <Spinner fx:id="qtySpinner"
                     prefWidth="120"/>
        </VBox>

        <HBox spacing="10"
              alignment="CENTER_LEFT">

            <Label text="Price:"
                   styleClass="price-label"/>

            <Label fx:id="priceLabel"
                   styleClass="price"
                   text="0.00"/>

        </HBox>

        <Button text="Add to Order"
                onAction="#handleAdd"
                maxWidth="Infinity"
                styleClass="primary-button"/>

    </VBox>

    <StackPane prefWidth="420"
               prefHeight="470"
               alignment="CENTER"
               styleClass="image-panel">

        <ImageView fx:id="coffeeImage"
                   fitWidth="260"
                   fitHeight="300"
                   preserveRatio="true"/>

    </StackPane>

</HBox>